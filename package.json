{
  "name": "@orenvill/mcp-sleuth",
  "version": "0.8.1",
  "description": "Investigate any MCP server \u2014 inspect the protocol, invoke tools, and audit what a server can reach, from the browser or the desktop app.",
  "license": "MIT",
  "author": "OrenVill (https://github.com/OrenVill)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrenVill/mcp-sleuth.git"
  },
  "homepage": "https://github.com/OrenVill/mcp-sleuth",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-inspector",
    "developer-tools",
    "debugging",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mcp-sleuth": "bin/mcp-sleuth.js"
  },
  "files": [
    "bin",
    "dist",
    "data-dir.js",
    "daemon-lock.js",
    "server.js",
    "proxy.js",
    "proxy.d.ts",
    "stdio-bridge.js",
    "stdio-bridge.d.ts",
    "vault-file-handler.js",
    "vault-file-handler.d.ts",
    "app-data-handler.js",
    "app-data-handler.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --headed",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "electron:dev": "MCP_SLEUTH_DEV_URL=http://localhost:5173 electron electron/main.js",
    "electron:start": "npm run build && electron electron/main.js",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "prepublishOnly": "cp README.md _README.github.md && cp README.npm.md README.md",
    "postpublish": "mv _README.github.md README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/binding-linux-x64-gnu": "^1.0.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
